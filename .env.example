# API local
PORT=3333
DATABASE_PATH=./apps/api/data/conexao-youtube.db
JWT_SECRET=
AUTH_CODE_PEPPER=
AUTH_DEV_MODE=true
PAYMENTS_DEV_MODE=true
REQUIRE_GROUP_MEMBERSHIP=true
ALLOWED_GROUP_CODES=1,2,10
WEB_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3333
ANDROID_APP_ORIGIN=https://localhost

# Owners são identificados no backend por nome + WhatsApp configurado e Credencial distinta.
# O marcador # é interno à API e nunca deve ser solicitado ao usuário na interface.
# Não publique telefones pessoais ou segredos.
OWNER_FABIO_NAME=Fabio0
OWNER_FABIO_ID=fabio0
OWNER_FABIO_SECRET=
OWNER_FABIO_WHATSAPP=
OWNER_RAFAEL_NAME=Rafael0
OWNER_RAFAEL_ID=rafael0
OWNER_RAFAEL_SECRET=
OWNER_RAFAEL_WHATSAPP=
# Número Business do atendimento / Quero participar (DDI+DDD+número).
OWNER_WHATSAPP=
# Número administrativo que recebe alertas de novos registros.
OWNER_ALERT_WHATSAPP=

# Cloud API Meta; webhook HTTPS público: /webhooks/whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v24.0
# Templates precisam ser criados/aprovados na Meta; ver docs/WHATSAPP-INTEGRACAO.md.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OWNER_ALERT_TEMPLATE=
WHATSAPP_DECISION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GROUPS_SYNC_ENABLED=true
WHATSAPP_GROUPS_SYNC_MINUTES=5

# Complemento opcional para grupos tradicionais. Ative somente pelo Owner após consentimento.
WPP_CONNECT_URL=http://127.0.0.1:21465
WPP_CONNECT_SESSION=sos-youtube
WPP_CONNECT_TOKEN=

# Google / YouTube
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Mercado Pago Pix
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
VITE_API_URL=http://localhost:3333

# Initial public Business phone; after initialization the Owner setting in SQLite takes precedence.
# Leave empty to use the approved project default. This is NOT a Meta Phone Number ID.
WHATSAPP_BUSINESS_PHONE=
