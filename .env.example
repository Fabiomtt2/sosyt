# API
PORT=3333
DATABASE_PATH=./apps/api/data/conexao-youtube.db
JWT_SECRET=troque-por-um-segredo-longo-com-32-caracteres
AUTH_CODE_PEPPER=troque-por-outro-segredo
AUTH_DEV_MODE=true
PAYMENTS_DEV_MODE=true
WEB_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3333

# YouTube / Google Cloud OAuth
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/youtube/callback
# Base64 de exatamente 32 bytes. Em desenvolvimento, a API deriva uma chave do JWT_SECRET.
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Pix Mercado Pago. Sem token, o modo de demonstração continua disponível localmente.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Cliente web/mobile
VITE_API_URL=http://localhost:3333

